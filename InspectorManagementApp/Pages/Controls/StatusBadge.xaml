<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="InspectorManagementApp.Pages.Controls.StatusBadge"
    x:Name="Root">

    <Border
        Padding="10,5"
        BackgroundColor="{StaticResource PendingBadgeBackgroundColor}"
        StrokeThickness="0"
        StrokeShape="RoundRectangle 12">

        <Border.Triggers>
            <DataTrigger
                TargetType="Border"
                Binding="{Binding Status, Source={x:Reference Root}}"
                Value="In Progress">
                <Setter
                    Property="BackgroundColor"
                    Value="{StaticResource InProgressBadgeBackgroundColor}" />
            </DataTrigger>

            <DataTrigger
                TargetType="Border"
                Binding="{Binding Status, Source={x:Reference Root}}"
                Value="Completed">
                <Setter
                    Property="BackgroundColor"
                    Value="{StaticResource CompletedBadgeBackgroundColor}" />
            </DataTrigger>
        </Border.Triggers>

        <Label
            Text="{Binding Status, Source={x:Reference Root}}"
            FontFamily="{StaticResource SemiboldFontFamily}"
            FontSize="{StaticResource CaptionFontSize}"
            TextColor="{StaticResource PendingBadgeTextColor}"
            HorizontalTextAlignment="Center">

            <Label.Triggers>
                <DataTrigger
                    TargetType="Label"
                    Binding="{Binding Status, Source={x:Reference Root}}"
                    Value="In Progress">
                    <Setter
                        Property="TextColor"
                        Value="{StaticResource InProgressBadgeTextColor}" />
                </DataTrigger>

                <DataTrigger
                    TargetType="Label"
                    Binding="{Binding Status, Source={x:Reference Root}}"
                    Value="Completed">
                    <Setter
                        Property="TextColor"
                        Value="{StaticResource CompletedBadgeTextColor}" />
                </DataTrigger>
            </Label.Triggers>
        </Label>

    </Border>
</ContentView>
