<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:InspectorManagementApp.Pages.Controls"
    x:Class="InspectorManagementApp.Pages.DashboardPage"
    Title="Dashboard"
    BackgroundColor="{StaticResource PageBackgroundColor}">

    <ScrollView>
        <VerticalStackLayout
            Padding="{StaticResource DashboardPagePadding}"
            Spacing="{StaticResource DashboardPageSpacing}">

            <!-- Dashboard Heading -->
            <VerticalStackLayout Spacing="{StaticResource DashboardHeadingSpacing}">

                <Label
                    Text="Inspector Dashboard"
                    Style="{StaticResource DashboardHeadingStyle}" />

                <Label
                    Text="Overview of inspection activities"
                    Style="{StaticResource DashboardSubtitleStyle}" />

            </VerticalStackLayout>

            <!-- Summary Cards -->
            <Grid
                RowDefinitions="Auto, 12, Auto"
                ColumnDefinitions="*, 12, *">

                <!-- Total -->
                <ContentView
                    Grid.Row="0"
                    Grid.Column="0"
                    ControlTemplate="{StaticResource CardControlTemplate}">

                    <VerticalStackLayout Spacing="{StaticResource DashboardCardSpacing}">
                        <Label
                            Text="Total Inspections"
                            Style="{StaticResource DashboardMetricLabelStyle}" />

                        <Label
                            Text="24"
                            Style="{StaticResource DashboardMetricValueStyle}" />
                    </VerticalStackLayout>
                </ContentView>

                <!-- Pending -->
                <ContentView
                    Grid.Row="0"
                    Grid.Column="2"
                    ControlTemplate="{StaticResource CardControlTemplate}">

                    <VerticalStackLayout Spacing="{StaticResource DashboardCardSpacing}">
                        <Label
                            Text="Pending"
                            Style="{StaticResource DashboardMetricLabelStyle}" />

                        <Label
                            Text="6"
                            Style="{StaticResource DashboardMetricValueStyle}" />
                    </VerticalStackLayout>
                </ContentView>

                <!-- In Progress -->
                <ContentView
                    Grid.Row="2"
                    Grid.Column="0"
                    ControlTemplate="{StaticResource CardControlTemplate}">

                    <VerticalStackLayout Spacing="{StaticResource DashboardCardSpacing}">
                        <Label
                            Text="In Progress"
                            Style="{StaticResource DashboardMetricLabelStyle}" />

                        <Label
                            Text="8"
                            Style="{StaticResource DashboardMetricValueStyle}" />
                    </VerticalStackLayout>
                </ContentView>

                <!-- Completed -->
                <ContentView
                    Grid.Row="2"
                    Grid.Column="2"
                    ControlTemplate="{StaticResource CardControlTemplate}">

                    <VerticalStackLayout Spacing="{StaticResource DashboardCardSpacing}">
                        <Label
                            Text="Completed"
                            Style="{StaticResource DashboardMetricLabelStyle}" />

                        <Label
                            Text="10"
                            Style="{StaticResource DashboardMetricValueStyle}" />
                    </VerticalStackLayout>
                </ContentView>

            </Grid>

            <!-- Today's Inspections -->
            <VerticalStackLayout Spacing="{StaticResource DashboardSectionSpacing}">

                <Label
                    Text="Today's Inspections"
                    Style="{StaticResource DashboardSectionHeadingStyle}" />

                <!-- Inspection 1 -->
                <Border Style="{StaticResource DashboardInspectionCardStyle}">
                    <VerticalStackLayout Spacing="{StaticResource DashboardInspectionSpacing}">

                        <Label
                            Text="Factory Safety Inspection"
                            Style="{StaticResource DashboardInspectionTitleStyle}" />

                        <Label
                            Text="Site: Industrial Area, Building A"
                            Style="{StaticResource DashboardDetailStyle}" />

                        <Label
                            Text="Scheduled: 10:00 AM"
                            Style="{StaticResource DashboardDetailStyle}" />

                        <controls:StatusBadge Status="In Progress" />

                    </VerticalStackLayout>
                </Border>

                <!-- Inspection 2 -->
                <Border Style="{StaticResource DashboardInspectionCardStyle}">
                    <VerticalStackLayout Spacing="{StaticResource DashboardInspectionSpacing}">

                        <Label
                            Text="Equipment Quality Check"
                            Style="{StaticResource DashboardInspectionTitleStyle}" />

                        <Label
                            Text="Site: Manufacturing Unit 2"
                            Style="{StaticResource DashboardDetailStyle}" />

                        <Label
                            Text="Scheduled: 12:30 PM"
                            Style="{StaticResource DashboardDetailStyle}" />

                        <controls:StatusBadge Status="Pending" />

                    </VerticalStackLayout>
                </Border>

                <!-- Inspection 3 -->
                <Border Style="{StaticResource DashboardInspectionCardStyle}">
                    <VerticalStackLayout Spacing="{StaticResource DashboardInspectionSpacing}">

                        <Label
                            Text="Building Compliance Review"
                            Style="{StaticResource DashboardInspectionTitleStyle}" />

                        <Label
                            Text="Site: Office Complex"
                            Style="{StaticResource DashboardDetailStyle}" />

                        <Label
                            Text="Scheduled: 03:00 PM"
                            Style="{StaticResource DashboardDetailStyle}" />

                        <controls:StatusBadge Status="Completed" />

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>

            <!-- Inspection Priority Tags -->
            <VerticalStackLayout Spacing="{StaticResource DashboardPrioritySpacing}">

                <Label
                    Text="Inspection Priorities"
                    Style="{StaticResource ProfileSectionHeadingStyle}" />

                <FlexLayout
                    Direction="Row"
                    Wrap="Wrap"
                    JustifyContent="Start"
                    AlignItems="Center">

                    <Border
                        Style="{StaticResource DashboardPriorityTagStyle}"
                        Margin="{StaticResource DashboardPriorityTagMargin}">
                        <Label
                            Text="High"
                            Style="{StaticResource DashboardPriorityTextStyle}" />
                    </Border>

                    <Border
                        Style="{StaticResource DashboardPriorityTagStyle}"
                        Margin="{StaticResource DashboardPriorityTagMargin}">
                        <Label
                            Text="Medium"
                            Style="{StaticResource DashboardPriorityTextStyle}" />
                    </Border>

                    <Border
                        Style="{StaticResource DashboardPriorityTagStyle}"
                        Margin="{StaticResource DashboardPriorityTagMargin}">
                        <Label
                            Text="Low"
                            Style="{StaticResource DashboardPriorityTextStyle}" />
                    </Border>

                </FlexLayout>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
